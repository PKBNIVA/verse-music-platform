source "https://rubygems.org"

ruby "3.3.6"

gem "rails", "~> 8.1.4"
gem "json", "~> 3.0"
gem "pg", "~> 1.5"
gem "puma", "~> 8.0"
gem "bcrypt", "~> 3.1"
gem "rack-cors", "~> 3.0"
gem "aws-sdk-s3", require: false
gem "faraday", "~> 2.12"
gem "jwt", "~> 3.3"
# Web push (VAPID + aes128gcm payload encryption); optional at runtime, see PushNotifications.
gem "web-push", "~> 3.1"
gem "redis", "~> 6.0"
gem "good_job", "~> 4.13"
gem "solid_cache", "~> 1.0"
# Action Cable adapter on the existing Postgres when no REDIS_URL is set (config/cable.yml).
gem "solid_cable", "~> 3.0"
gem "sentry-ruby", "~> 7.1"
gem "sentry-rails", "~> 7.0"
# One JSON line per request in production instead of Rails' multi-line request log (config/initializers/lograge.rb).
gem "lograge", "~> 0.14"
gem "bootsnap", require: false
# Pure-Ruby QR codes for the verified-share cards (ShareCard). No headless browser or
# ImageMagick is available in the production image, so the card is rendered as inline SVG.
gem "rqrcode", "~> 3.2"
# Image variants (ImageVariantsJob): libvips through ruby-vips; the Dockerfile installs libvips42.
gem "image_processing", "~> 1.14"

group :development, :test do
  gem "debug", platforms: %i[mri windows], require: "debug/prelude"
  # N+1 detection: raises in tests and logs in development (config/initializers/bullet.rb).
  gem "bullet", "~> 8.0"
  gem "brakeman", require: false
  gem "bundler-audit", require: false
end

group :test do
  # Line and branch coverage for bin/rails test; the floor lives in test/test_helper.rb.
  gem "simplecov", require: false
end
