PORT=4173
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_PATH=./data/verse.db
SESSION_COOKIE_SECURE=false
SEED_DEMO_DATA=true

# Razorpay Subscriptions (optional in local development; mock trials are used without these)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_STUDIO=

# Public URL used in email links, canonical tags and sitemap
PUBLIC_BASE_URL=http://localhost:3000

# Transactional email adapter. Verse POSTs {to, template, data} JSON to this webhook.
# Connect this to Brevo/SES/SendGrid/Postmark via your own tiny adapter/serverless function.
EMAIL_DELIVERY_WEBHOOK=
EMAIL_DELIVERY_TOKEN=

# Comma-separated browser origins allowed to call the API in production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional Elasticsearch cluster. When omitted, Verse transparently falls back to SQLite search.
# Recommended in production for fuzzy, cross-entity search and larger catalogues.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_PREFIX=verse

# Media uploads. In production, prefer a webhook that returns direct signed object-storage upload details.
OBJECT_STORAGE_UPLOAD_WEBHOOK=
OBJECT_STORAGE_TOKEN=
# Local uploads are convenient for development only. Do not use on ephemeral/multi-instance production hosts.
ALLOW_LOCAL_UPLOADS=false
