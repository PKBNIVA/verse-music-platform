# Vercel frontend
VITE_API_URL=https://verse-music-platform-production.up.railway.app/api
VITE_PUBLIC_URL=https://verse-music-platform.vercel.app

# Rails API on Railway
RAILS_ENV=production
SECRET_KEY_BASE=generate-with-openssl-rand-hex-64
DATABASE_URL=provided-by-railway-postgresql
FRONTEND_URL=https://verse-music-platform.vercel.app
FRONTEND_HOST=verse-music-platform.vercel.app
ALLOWED_ORIGINS=https://verse-music-platform.vercel.app
API_HOST=https://verse-music-platform-production.up.railway.app
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-unique-password-of-at-least-14-characters
SEED_DEMO_DATA=false

# S3-compatible object storage (Cloudflare R2, AWS S3, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT_URL_S3=
# Required whenever AWS_ENDPOINT_URL_S3 is set (R2): the https r2.dev or custom-domain origin.
AWS_PUBLIC_BASE_URL=
# Optional: post | put. Defaults to put for *.r2.cloudflarestorage.com, post otherwise.
AWS_UPLOAD_METHOD=

# Durable jobs use the Railway PostgreSQL database.
GOOD_JOB_EXECUTION_MODE=async
GOOD_JOB_MAX_THREADS=2
GOOD_JOB_POLL_INTERVAL=10
GOOD_JOB_ENABLE_CRON=true

# Transactional email. Prefer one configured provider.
EMAIL_DELIVERY_WEBHOOK=
EMAIL_DELIVERY_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=Verse <notifications@your-domain.com>
BREVO_API_KEY=
BREVO_SENDER_EMAIL=admin@notify.alienbrains.in
BREVO_SENDER_NAME=Verse

# Sign-in. Email codes (POST /api/auth/otp/*) are always on. Keep password login
# enabled until production email delivery (inbox receipt) is verified; setting
# "false" makes /api/auth/login return 403 PASSWORD_LOGIN_DISABLED.
PASSWORD_LOGIN_ENABLED=true

# Razorpay. Leave blank until live checkout and webhooks are ready.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_STUDIO=

# Temporary gate for reversible synthetic QA only.
ALLOW_SYNTHETIC_QA=false
SYNTHETIC_QA_PASSWORD=

# Error tracking (Sentry). Blank = disabled; see DEPLOYMENT.md "Error alerting and uptime".
# API (Railway):
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
# Web (Vercel, read at build time):
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
