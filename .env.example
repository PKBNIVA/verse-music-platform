# Vercel frontend
VITE_API_URL=https://your-verse-api.up.railway.app/api
VITE_PUBLIC_URL=https://your-verse-app.vercel.app

# Rails API (Railway now; the same variables work on Heroku later)
RAILS_ENV=production
SECRET_KEY_BASE=generate-with-openssl-rand-hex-64
DATABASE_URL=provided-by-heroku-postgres
FRONTEND_URL=https://your-verse-app.vercel.app
FRONTEND_HOST=your-verse-app.vercel.app
ALLOWED_ORIGINS=https://your-verse-app.vercel.app
API_HOST=https://your-verse-api.herokuapp.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-unique-password-of-at-least-14-characters
SEED_DEMO_DATA=false

# S3-compatible object storage (AWS S3, Cloudflare R2, Supabase Storage gateway, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_PUBLIC_BASE_URL=
REDIS_URL=
# Durable Active Job execution uses the existing PostgreSQL database. `async`
# runs two low-volume worker threads inside Puma; use `external` when a separate
# Railway worker service is provisioned later.
GOOD_JOB_EXECUTION_MODE=async
GOOD_JOB_MAX_THREADS=2
GOOD_JOB_POLL_INTERVAL=10
GOOD_JOB_ENABLE_CRON=true
EMAIL_DELIVERY_WEBHOOK=
EMAIL_DELIVERY_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=Verse <notifications@your-domain.com>
BREVO_API_KEY=
BREVO_SENDER_EMAIL=admin@notify.alienbrains.in
BREVO_SENDER_NAME=Verse
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_STUDIO=
