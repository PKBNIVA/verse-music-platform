{
  "name": "musilynk",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build && npm run build:ssr && node scripts/prerender-heads.mjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:perf": "node scripts/perf/check-perf.mjs",
    "perf:measure": "node scripts/perf/measure.mjs",
    "perf:photos": "node scripts/perf/build-photos.mjs",
    "build:admin": "VITE_APP_TARGET=admin vite build --outDir dist-admin",
    "check:split": "npm run build:admin && node scripts/check-site-split.mjs",
    "dev": "vite",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,mjs}\" \"*.{ts,js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,mjs}\" \"*.{ts,js,mjs}\"",
    "test:rails": "cd backend && bin/rails test",
    "test:frontend-bootstrap": "node tests/frontend-bootstrap-smoke.mjs",
    "test:frontend-request-resilience": "node tests/frontend-request-resilience-smoke.mjs",
    "test:frontend-resilience": "node tests/frontend-resilience-smoke.mjs",
    "test:frontend-monitoring": "node tests/frontend-monitoring-smoke.mjs",
    "test:frontend-performance": "node tests/frontend-performance-smoke.mjs",
    "test:frontend-native-dialogs": "node tests/frontend-native-dialogs-smoke.mjs",
    "test:all": "npm run test:frontend-bootstrap && npm run test:frontend-request-resilience && npm run test:frontend-resilience && npm run test:frontend-monitoring && npm run test:frontend-native-dialogs && npm run test:frontend-performance",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "qa:e2e": "playwright test",
    "qa:e2e:public": "playwright test tests/e2e/public-experience.spec.ts tests/e2e/accessibility.spec.ts",
    "qa:e2e:api": "playwright test tests/e2e/api-health.spec.ts --project=api",
    "qa:e2e:report": "playwright show-report",
    "brand:build": "node scripts/brand/build-logo.mjs",
    "brand:check": "node scripts/brand/build-logo.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-aspect-ratio": "1.1.15",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-menubar": "1.1.24",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@rails/actioncable": "8.1.400",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/react": "11.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.51.0",
    "motion": "14.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.89.0",
    "react-parallax-tilt": "^1.7.344",
    "react-resizable-panels": "2.1.7",
    "react-router": "7.18.4",
    "recharts": "3.10.1",
    "satori": "0.35.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "overrides": {
      "vite": "8.3.2"
    }
  }
}
